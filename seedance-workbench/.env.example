# 智云 TokenHub API Key（缺失时自动进入 Mock 模式，不会真实扣费）
TOKENHUB_API_KEY=

# 网关与模型（一般无需修改）
TOKENHUB_BASE_URL=https://aigw.telecomjs.com
TOKENHUB_SEEDANCE_MODEL=doubao-seedance-2-0-260128

# Mock 模式开关：auto（无 Key 自动 Mock）/ true（强制 Mock）/ false（强制真实）
SEEDANCE_MOCK=auto

# 轮询与超时（秒）
SEEDANCE_POLL_INTERVAL_SECONDS=10
SEEDANCE_MAX_WAIT_SECONDS=900
# 服务重启后仍恢复轮询的任务窗口（秒）
SEEDANCE_RESUME_WINDOW_SECONDS=1800

# 可选：可信价格（元/秒），配置后前端才显示预估费用；不配置则显示"价格未知"
SEEDANCE_PRICE_CNY_PER_SECOND=

# 图片上传上限（字节）
SEEDANCE_MAX_IMAGE_BYTES=8388608

# 本地视频上传与临时 HTTPS 通道
SEEDANCE_MAX_VIDEO_BYTES=52428800
SEEDANCE_CLOUDFLARED_PATH=
SEEDANCE_VIDEO_UPLOAD_TTL_SECONDS=1800
SEEDANCE_VIDEO_POST_TASK_GRACE_SECONDS=300
SEEDANCE_TUNNEL_START_TIMEOUT_SECONDS=30

# 数据目录（SQLite 任务库 / 上传图片 / Mock 样例视频）
SEEDANCE_DATA_DIR=./data
